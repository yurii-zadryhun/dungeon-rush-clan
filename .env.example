# Run with npm install && npm run build && npm start
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://clan.example.com
DATA_DIR=./data
# First-time owner enrollment only. Remove/rotate after setup.
BOOTSTRAP_TOKEN=
# Google Cloud Vision API key with Cloud Vision API enabled.
GOOGLE_VISION_API_KEY=
# Server-side Gemini API key for the optional free-tier Gemma wiki assistant.
# Keep the Google AI project on Free Tier; never expose this key to Vite or the browser.
GEMINI_API_KEY=
